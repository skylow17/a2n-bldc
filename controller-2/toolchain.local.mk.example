# Chemins de la toolchain, propres a ce poste.
#
#   cp toolchain.local.mk.example toolchain.local.mk
#
# puis corriger les trois chemins ci-dessous. toolchain.local.mk est ignore par
# git : deux postes peuvent avoir des installations differentes sans jamais se
# marcher dessus, et rien de machine-specifique n'entre dans l'historique.
#
# Ou trouver ces chemins :
#
#   CUBE  Le paquet HAL STM32G4, installe par STM32CubeMX ou CubeIDE. Sous
#         Windows il atterrit par defaut dans %USERPROFILE%\STM32Cube\Repository.
#         Le dossier doit contenir Drivers/STM32G4xx_HAL_Driver.
#
#   IDE   Le dossier plugins de STM32CubeIDE. C'est lui qui fournit a la fois le
#         GCC arm-none-eabi et STM32_Programmer_CLI, donc rien d'autre n'est a
#         installer. Le numero de version des deux plugins change d'une version
#         de CubeIDE a l'autre : verifier les noms reels avec
#
#           ls "<IDE>" | grep -E "gnu-tools|cubeprogrammer"
#
#         et ajuster GCC_DIR / PROG_CLI ci-dessous si besoin.
#
# Utiliser des slash avant, meme sous Windows : make s'en accommode, et le
# backslash y est un caractere d'echappement.

# Le numero de version du paquet suit ce que CubeMX a telecharge : verifier le nom
# reel du dossier plutot que de recopier celui-ci.
CUBE := C:/Users/<utilisateur>/STM32Cube/Repository/STM32Cube_FW_G4_V1.6.3
IDE  := C:/ST/STM32CubeIDE_1.18.0/STM32CubeIDE/plugins

# A decommenter si les versions de plugins different de celles du Makefile, ce qui
# est le cas des que CubeIDE n'est pas en 1.18.0. Sur une installation 2.2.0, par
# exemple, les trois numeros changent a la fois -- GCC passe en 14.3.rel1 et le
# programmateur en 2.2.500. Les valeurs ci-dessous sont donc a relever, pas a
# recopier :
#
#   ls "<IDE>" | grep -E "gnu-tools|cubeprogrammer|externaltools.make"
#
# GCC_DIR  := $(IDE)/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.13.3.rel1.win32_1.0.0.202411081344/tools/bin
# PROG_CLI := $(IDE)/com.st.stm32cube.ide.mcu.externaltools.cubeprogrammer.win32_2.2.100.202412061334/tools/bin/STM32_Programmer_CLI.exe
